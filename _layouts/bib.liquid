{% comment %}
  Local override of al_folio_core's _layouts/bib.liquid.

  Renders each entry from _bibliography/papers.bib as a single flowing citation
  paragraph — authors, year, title, venue — with the link buttons inline at the
  end, instead of the theme's two-column card with a venue badge in the margin.

  Your own name is bolded automatically: it matches on `scholar.last_name` in
  _config.yml, so keep that in sync if you ever change how your name is spelled.

  Equal-contribution marks work: write `author = {Xu, Yi* and Bazarjani, Armin*}`
  in the .bib and the asterisk is carried through to the rendered initials.

  To go back to the stock al-folio look, delete this file.
{% endcomment %}

<div class="pub-entry" id="{{ entry.key }}">
  {%- assign n_authors = entry.author_array | size -%}
  {%- for author in entry.author_array -%}
    {%- assign initial = author.first | truncate: 1, '' -%}
    {%- assign surname = author.last | regex_replace: '[*†‡]', '' -%}
    {%- assign marks = author.last | regex_replace: '[^*†‡]', '' -%}
    {%- if forloop.first == false -%}
      {%- if forloop.last -%}
        , &amp;
      {%- else -%}
        ,
      {%- endif -%}
    {%- endif -%}
    {%- capture rendered_name %}{{ surname }}, {{ initial }}.{{ marks }}{% endcapture -%}
    {%- if site.scholar.last_name contains surname %} <strong>{{ rendered_name }}</strong>
    {%- else %} {{ rendered_name }}
    {%- endif -%}
  {%- endfor -%}
  {{ " " }}({{ entry.year }}).
  {{ entry.title }}.
  {%- if entry.type == 'article' and entry.journal %} <em>{{ entry.journal }}</em>{% endif -%}
  {%- if entry.type == 'inproceedings' or entry.type == 'incollection' %} <em>{{ entry.booktitle }}</em>{% endif -%}
  {%- if entry.type == 'phdthesis' or entry.type == 'mastersthesis' %} <em>{{ entry.school }}</em>{% endif -%}
  {%- if entry.volume %}, <em>{{ entry.volume }}</em>{% endif -%}
  {%- if entry.number %}({{ entry.number }}){% endif -%}
  {%- if entry.pages %}, {{ entry.pages }}{% endif -%}.
  {%- if entry.additional_info %} <em>{{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' }}</em>.{% endif %}

  <span class="links">
    {%- if entry.doi %}
      <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm z-depth-0" role="button">DOI</a>
    {%- endif -%}
    {%- if entry.arxiv %}
      <a href="http://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm z-depth-0" role="button">arXiv</a>
    {%- endif -%}
    {%- if entry.pdf %}
      {%- if entry.pdf contains '://' %}
        <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
      {%- else %}
        <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
      {%- endif -%}
    {%- endif -%}
    {%- if entry.abstract %}
      <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
    {%- endif -%}
    {%- if entry.bibtex_show %}
      <a class="bibtex btn btn-sm z-depth-0" role="button">Bib</a>
    {%- endif -%}
  </span>

  {%- comment -%}
    These panels must be siblings of .links inside this container — the theme's
    common.js finds them via link.closest('.links').parentElement.
  {%- endcomment -%}
  {% if entry.abstract %}
    <div class="abstract hidden">
      <p>{{ entry.abstract }}</p>
    </div>
  {% endif %}
  {% if entry.bibtex_show %}
    <div class="bibtex hidden">
      {% highlight bibtex %}
      {{- entry.bibtex | hideCustomBibtex -}}
    {% endhighlight %}
    </div>
  {% endif %}
</div>
